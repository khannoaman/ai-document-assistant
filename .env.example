# --- Secrets (leave blank / unset for providers you're not using) ---
GOOGLE_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
GROQ_API_KEY=
GROQ_FALLBACK_API_KEY=
QDRANT_API_KEY=
QDRANT_CLUSTER_ENDPOINT=

# Optional: sends observability data (spans/logs) to your Logfire project.
# Get a write token at https://logfire.pydantic.dev. Not read via
# app/config.py — the logfire SDK reads this env var directly. Without it,
# spans still print to the local console but nothing is sent to Logfire.
# Local `python -m app...` runs don't need this at all — `logfire auth` +
# `logfire projects use` (or the setup flow at your project's URL) writes a
# .logfire/logfire_credentials.json that's auto-discovered instead. Docker
# runs have no access to that file, so LOGFIRE_TOKEN is the only way
# containers actually send data.
LOGFIRE_TOKEN=

# --- Tunables (all optional, defaults shown; see app/config.py) ---
QDRANT_PORT=443
COLLECTION_NAME=ai_document_assistant_vector_store

EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GEMINI_EMBEDDING_MODEL=models/embedding-001

CHUNK_SIZE=800
CHUNK_OVERLAP=100
MIN_CONTENT_LENGTH=20

REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800
